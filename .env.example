# ========================================================
# LoopWorth Circular Recovery Platform - Environment Configuration
# ========================================================
# Copy this file to .env or configure in appsettings.Development.json

# Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=loopworthadmin@gmail.com
BREVO_SENDER_NAME=LoopWorth Circular Recovery

# Google Gemini AI Multi-Agent API Keys
GEMINI_ITEMS_API_KEY=your_gemini_items_api_key
GEMINI_RECOVERY_API_KEY=your_gemini_recovery_api_key
GEMINI_PARTNERS_API_KEY=your_gemini_partners_api_key
GEMINI_COLLECTION_API_KEY=your_gemini_collection_api_key
GEMINI_ECO_IMPACT_API_KEY=your_gemini_eco_impact_api_key

# Database Connection (Neon PostgreSQL)
CONNECTION_STRING=postgresql://username:password@hostname:5432/neondb?sslmode=require

# System Admin Seed Account
ADMIN_EMAIL=loopworthadmin@gmail.com
ADMIN_PASSWORD=Admin123!
